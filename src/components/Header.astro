---
import GameControlPanel from "./GameControlPanel.astro";

interface Props {
    variant?: "default" | "game";
}

const { variant = "default" } = Astro.props;

const brandName = "Truth Or Dare Spin";

const themes = [
    { id: "neon", name: "Neon After Dark", color: "#8B5CF6" },
    { id: "cyber", name: "Cyber Blue", color: "#38BDF8" },
    { id: "sunset", name: "Sunset Arcade", color: "#FB7185" },
    { id: "light", name: "Light Pop", color: "#7C3AED" },
];
---

<header class:list={["site-header", `site-header--${variant}`]}>
    {variant === "game" && <GameControlPanel />}

    {variant === "game" ? (
        /* =====================================================
           GAME HEADER
           ===================================================== */

        <div class="game-header-inner">

            <!-- LEFT L-SHAPE -->
            <div class="game-control-group game-control-group--left">

                <!-- Theme -->
                <button
                    class="game-control game-control--theme"
                    type="button"
                    aria-label="Choose theme"
                    data-game-control="theme"
                >
                    <span class="game-control__icon" aria-hidden="true">
                        <svg
                            viewBox="0 0 48 48"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M6.97 14.62V2.5a25.13 25.13 0 0 0 11.34 2.77C24.79 5.27 26.88 2 34.11 2a22.97 22.97 0 0 1 6.93 1.51v11.11M41.03 14.62v11.54c0 3.38-3.91 3.65-7.49 3.65s-6.54 1.5-6.54 4.89c0 1.53 1 1.86 1 4.22S26.75 42.5 24 42.5s-4-1.22-4-3.58 1-2.69 1-4.22c0-3.39-2.96-4.9-6.54-4.9s-7.49-.26-7.49-3.64V14.62M6.97 14.62h34.06"
                                stroke="currentColor"
                                stroke-width="3"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </span>
                    <span class="game-control__label">Theme</span>
                </button>

                <!-- Board -->
                <button
                    class="game-control game-control--board"
                    type="button"
                    aria-label="Choose board"
                    data-game-control="board"
                >
                    <span class="game-control__icon" aria-hidden="true">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M8.1 21.21q-1.82-.79-3.17-2.14Q3.58 17.73 2.79 15.9T2 12q0-2.08.79-3.9.79-1.83 2.14-3.17Q6.28 3.57 8.1 2.79 9.93 2 12 2t3.9.79q1.82.79 3.17 2.14 1.35 1.35 2.14 3.17Q22 9.92 22 12t-.79 3.9q-.79 1.82-2.14 3.17-1.35 1.35-3.17 2.14T12 22q-2.07 0-3.9-.79Zm9.58-3.54Q20 15.35 20 12t-2.32-5.68T12 4 6.33 6.32 4 12t2.33 5.68T12 20t5.68-2.32ZM7.75 16.25Q6 14.5 6 12t1.75-4.25T12 6t4.25 1.75T18 12t-1.75 4.25T12 18t-4.25-1.75Zm7.08-1.43Q16 13.65 16 12t-1.17-2.83T12 8 9.18 9.17 8 12t1.18 2.82T12 16t2.83-1.18Zm-4.24-1.41Q10 12.83 10 12t.59-1.41T12 10t1.41.59Q14 11.18 14 12t-.59 1.41T12 14t-1.41-.59Z"
                                fill="currentColor"
                            />
                        </svg>
                    </span>
                    <span class="game-control__label">Board</span>
                </button>

                <!-- Bottle -->
                <button
                    class="game-control game-control--bottle"
                    type="button"
                    aria-label="Choose bottle"
                    data-game-control="bottle"
                >
                    <span class="game-control__icon" aria-hidden="true">
                        <svg
                            viewBox="0 0 150 150"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <g
                                fill="none"
                                stroke="currentColor"
                                stroke-linejoin="round"
                                stroke-linecap="round"
                                stroke-width="9"
                            >
                                <path
                                    d="m133.86 3.85c3.95 3.01 7.35 7.23 10.86 10.74 1.6 1.61 3.24 3.92 2.87 6.35-.62 4.07-4.22 7.94-8.09 9.25-1.31.44-2.95-.15-4.12.69-1.87 1.33-3.41 3.45-5.01 5.1-3.08 3.19-6.49 6.37-9.21 9.88-2.45 3.14-4.6 6.54-5.98 10.3-1.18 3.24-1.58 6.61-2.47 9.92-1.44 5.32-3.21 10.28-6.08 15.02-3.27 5.38-8.46 9.71-12.86 14.11-7.79 7.8-15.64 15.55-23.38 23.41-5.63 5.72-11.3 11.41-16.97 17.09-2.77 2.77-5.48 6.29-8.71 8.5-4.72 3.25-10.75 3.93-15.62.41-1.99-1.43-3.61-3.33-5.41-4.98-4.94-4.53-9.72-9.38-14.33-14.24-3.14-3.33-6.39-6.71-6.51-11.57-.16-6.45 3.84-10.05 8.07-14.31 4.35-4.39 8.73-8.75 13.09-13.12 9.16-9.18 18.35-18.33 27.52-27.51 5.61-5.61 11.03-12.01 17.85-16.2 4.09-2.51 8.82-4.34 13.45-5.56 4.43-1.16 8.86-1.74 13.07-3.62 6.08-2.71 10.89-7.78 15.65-12.29 2.33-2.2 5.25-4.29 7.2-6.86.79-1.03.3-2.53.58-3.74.41-1.69 1.46-3.2 2.57-4.49 3.22-3.75 7.74-5.5 11.96-2.29z"
                                />
                                <path d="M86 53C72 60 57 74 30 100" />
                            </g>
                        </svg>
                    </span>
                    <span class="game-control__label">Bottle</span>
                </button>
            </div>


            <!-- CENTER TITLE -->
            <a
                class="site-logo game-site-logo"
                href="/"
                aria-label="TruthOrDareSpin home"
            >
                {brandName}
            </a>


            <!-- RIGHT L-SHAPE -->
            <div class="game-control-group game-control-group--right">

                <!-- Settings -->
                <button
                    class="game-control game-control--settings"
                    type="button"
                    aria-label="Settings"
                    data-game-control="settings"
                >
                    <span class="game-control__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path
                                d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"
                                fill="currentColor"
                            />
                        </svg>
                    </span>
                    <span class="game-control__label">Settings</span>
                </button>

                <!-- Volume -->
                <button
                    class="game-control game-control--volume"
                    type="button"
                    aria-label="Volume"
                    data-game-control="volume"
                >
                    <span class="game-control__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path
                                d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
                                fill="currentColor"
                            />
                        </svg>
                    </span>
                    <span class="game-control__label">Volume</span>
                </button>

                <!-- Music -->
                <button
                    class="game-control game-control--music"
                    type="button"
                    aria-label="Music"
                    data-game-control="music"
                >
                    <span class="game-control__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path
                                d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                fill="currentColor"
                            />
                        </svg>
                    </span>
                    <span class="game-control__label">Music</span>
                </button>
            </div>
        </div>

    ) : (

        /* =====================================================
           STANDARD WEBSITE HEADER
           ===================================================== */

        <>
            <div class="header-inner">

                <button
                    class="header-menu-button"
                    type="button"
                    aria-label="Open navigation menu"
                    aria-expanded="false"
                    aria-controls="left-menu"
                    data-menu-trigger="left"
                >
                    <img
                        src="/game-assets/svg/menu-bottle.svg"
                        alt=""
                        width="28"
                        height="28"
                    />
                </button>

                <a class="site-logo" href="/" aria-label="TruthOrDareSpin home">
                    {brandName}
                </a>

                <button
                    class="header-menu-button right-bottle"
                    type="button"
                    aria-label="Open game menu"
                    aria-expanded="false"
                    aria-controls="right-menu"
                    data-menu-trigger="right"
                >
                    <img
                        src="/game-assets/svg/menu-bottle.svg"
                        alt=""
                        width="28"
                        height="28"
                    />
                </button>

            </div>

            <nav
                id="left-menu"
                class="header-menu"
                aria-label="Site navigation"
                hidden
            >
                <a href="/how-to-play/">How to Play</a>

                <button
                    type="button"
                    class="menu-row"
                    data-theme-toggle
                    aria-expanded="false"
                    aria-controls="theme-panel"
                >
                    <span>Theme</span>
                    <span class="menu-chevron" aria-hidden="true">›</span>
                </button>

                <div id="theme-panel" class="theme-panel" hidden>
                    {themes.map((theme) => (
                        <button
                            type="button"
                            class="theme-option"
                            data-theme-option={theme.id}
                            aria-pressed={theme.id === "neon" ? "true" : "false"}
                        >
                            <span
                                class="theme-swatch"
                                style={`--swatch-color: ${theme.color}`}
                                aria-hidden="true"
                            ></span>
                            <span>{theme.name}</span>
                            <span class="theme-check" aria-hidden="true">✓</span>
                        </button>
                    ))}
                </div>

                <a href="/about/">About</a>
            </nav>

            <nav
                id="right-menu"
                class="header-menu right-menu"
                aria-label="Game menu"
                hidden
            >
                <a href="/play/">Game</a>
                <button type="button" data-game-action="sound">Sound</button>
            </nav>
        </>
    )}

</header>

<script>
    import "../scripts/menu.js";
    import "../scripts/theme.js";
</script>

<style>
    /* =====================================================
       BASE HEADER
       ===================================================== */

    .site-header {
        position: relative;
        z-index: 100;
    }

    /* =====================================================
       STANDARD HEADER
       ===================================================== */

    .header-inner {
        width: min(100% - 32px, 1100px);
        min-height: 50px;
        margin-inline: auto;
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr) 44px;
        align-items: center;
        gap: 12px;
    }

    .header-menu-button {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        padding: 6px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--color-text);
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .header-menu-button img {
        display: block;
        width: 32px;
        height: 32px;
        object-fit: contain;
    }

    .right-bottle img {
        transform: scaleX(-1);
    }

    :global(html[data-theme="light"]) .header-menu-button img {
        filter: brightness(0.15) !important;
    }

    .header-menu-button:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
        border-radius: 8px;
    }

    /* =====================================================
       COMMON LOGO
       ===================================================== */

    .site-logo {
        justify-self: center;
        font-family: "Bungee", sans-serif;
        font-size: clamp(16px, 4vw, 22px);
        font-weight: 800;
        letter-spacing: 0.5px;
        text-decoration: none;
        white-space: nowrap;

        background: linear-gradient(
            45deg,
            #00F5FF,
            #FFD700,
            #FF2E63,
            #39FF14,
            #FF6B35,
            #00F5FF
        );

        background-size: 300% 300%;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;

        animation: zigzag-shift 4s ease infinite;
    }

    @keyframes zigzag-shift {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* =====================================================
       STANDARD DROPDOWN MENUS
       ===================================================== */

    .header-menu {
        position: absolute;
        top: calc(100% + 8px);
        left: 16px;
        width: min(280px, calc(100vw - 32px));
        max-height: min(70vh, 480px);
        overflow-y: auto;
        padding: 8px;
        border: 1px solid var(--color-border);
        border-radius: 14px;
        background: var(--color-card);
        color: var(--color-text);
        box-shadow: var(--shadow-card);
    }

    .header-menu[hidden],
    .theme-panel[hidden] {
        display: none;
    }

    .header-menu.right-menu {
        right: 16px;
        left: auto;
        width: min(240px, calc(100vw - 32px));
    }

    .header-menu > a,
    .header-menu > button,
    .theme-option {
        display: flex;
        width: 100%;
        min-height: 44px;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border: 0;
        border-radius: 9px;
        background: transparent;
        color: var(--color-text);
        font: inherit;
        font-size: 14px;
        text-align: left;
        text-decoration: none;
        cursor: pointer;
    }

    .header-menu > a:hover,
    .header-menu > button:hover,
    .theme-option:hover {
        background: var(--color-surface);
    }

    .menu-row {
        justify-content: space-between;
    }

    .menu-chevron {
        color: var(--color-muted);
        font-size: 22px;
        line-height: 1;
        transition: transform 160ms ease;
    }

    [data-theme-toggle][aria-expanded="true"] .menu-chevron {
        transform: rotate(90deg);
    }

    .theme-panel {
        margin: 2px 0 6px 10px;
        padding-left: 6px;
        border-left: 1px solid var(--color-border);
    }

    .theme-option {
        min-height: 40px;
        gap: 9px;
        font-size: 13px;
    }

    .theme-swatch {
        flex: 0 0 13px;
        width: 13px;
        height: 13px;
        border-radius: 50%;
        background: var(--swatch-color);
        box-shadow: 0 0 0 2px var(--color-card);
        outline: 1px solid var(--color-border);
    }

    .theme-check {
        margin-left: auto;
        color: var(--color-accent);
        opacity: 0;
    }

    .theme-option[aria-pressed="true"] .theme-check {
        opacity: 1;
    }

    /* =====================================================
       GAME HEADER
       ===================================================== */

    .site-header--game {
        position: absolute;
        inset: 0 0 auto 0;
        z-index: 100;
        background: transparent;
        border: 0;
        pointer-events: none;
    }

    .game-header-inner {
        width: 100%;
        max-width: 1200px;
        min-height: 52px;
        margin-inline: auto;
        padding: 8px 16px;
        box-sizing: border-box;

        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: start;
        gap: 12px;
    }

    .game-control-group {
        display: grid;
        grid-template-columns: repeat(2, var(--game-control-size));
        grid-template-rows: repeat(2, var(--game-control-size));
        gap: var(--game-control-gap);
        flex-shrink: 0;
    }

    .game-control-group--left .game-control:nth-child(1) {
        grid-column: 1;
        grid-row: 1;
    }

    .game-control-group--left .game-control:nth-child(2) {
        grid-column: 2;
        grid-row: 1;
    }

    .game-control-group--left .game-control:nth-child(3) {
        grid-column: 1;
        grid-row: 2;
    }

    .game-control-group--right .game-control:nth-child(1) {
        grid-column: 1;
        grid-row: 1;
    }

    .game-control-group--right .game-control:nth-child(2) {
        grid-column: 2;
        grid-row: 1;
    }

    .game-control-group--right .game-control:nth-child(3) {
        grid-column: 2;
        grid-row: 2;
    }

    .game-control {
        width: var(--game-control-size);
        height: var(--game-control-size);

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 5px;
        border: 2px solid var(--color-border);
        border-radius: 12px;

        background: var(--color-card);
        color: var(--color-text);

        cursor: pointer;
        -webkit-tap-highlight-color: transparent;

        transition:
            transform 150ms ease,
            background-color 150ms ease,
            border-color 150ms ease,
            box-shadow 150ms ease;
    }

    .game-control:hover {
        transform: translateY(-2px);
        background: var(--color-surface);
        box-shadow: var(--shadow-card);
    }

    .game-control:active {
        transform: scale(0.94);
    }

    .game-control:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 3px;
    }

    .game-control__icon {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
    }

    .game-control__icon svg {
        width: var(--game-icon-size);
        height: var(--game-icon-size);
        display: block;
        flex-shrink: 0;
    }

    .game-control__label {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .game-site-logo {
        align-self: start;
        margin-top: 12px;
        pointer-events: auto;
        font-size: clamp(16px, 3.5vw, 22px);
        text-align: center;
    }

    .game-control {
        pointer-events: auto;
    }

    /* =====================================================
       GAME HEADER VARIABLES
       ===================================================== */

    .site-header--game {
        --game-control-size: clamp(40px, 8.5vw, 52px);
        --game-icon-size: clamp(21px, 4.5vw, 27px);
        --game-control-gap: 6px;
    }

    /* =====================================================
       DESKTOP GAME HEADER
       ===================================================== */

    @media (min-width: 768px) {

        .game-header-inner {
            min-height: 76px;
            padding: 10px 20px;
            grid-template-columns: auto minmax(0, 1fr) auto;
            align-items: center;
            gap: 18px;
        }

        .game-control-group {
            display: flex;
            align-items: center;
            gap: 10px;
            width: auto;
            height: auto;
        }

        .game-control-group--left .game-control,
        .game-control-group--right .game-control {
            width: 48px;
            height: 48px;
        }

        .game-control-group--left .game-control,
        .game-control-group--right .game-control {
            grid-column: auto;
            grid-row: auto;
        }

        .game-site-logo {
            margin-top: 0;
            font-size: clamp(20px, 2.5vw, 26px);
        }

        .game-control__label {
            position: absolute;
        }
    }

    /* =====================================================
       SMALL MOBILE
       ===================================================== */

    @media (max-width: 380px) {

        .game-header-inner {
            padding-inline: 8px;
            gap: 6px;
        }

        .site-header--game {
            --game-control-size: 38px;
            --game-icon-size: 20px;
            --game-control-gap: 5px;
        }

        .game-site-logo {
            font-size: 15px;
            letter-spacing: -0.5px;
        }

        .game-control {
            border-radius: 10px;
            border-width: 1.5px;
        }
    }

    /* =====================================================
       REDUCED MOTION
       ===================================================== */

    @media (prefers-reduced-motion: reduce) {

        .site-logo {
            animation: none;
        }

        .game-control {
            transition: none;
        }
    }
</style>