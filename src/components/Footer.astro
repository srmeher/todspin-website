
<footer class="site-footer">
    <section
        id="footer-drawer"
        class="footer-drawer"
        aria-label="Website links"
        hidden
    >
        <div class="drawer-heading">
            <h2>Explore TruthOrDareSpin</h2>
            <p>Everything you need to get the fun started.</p>
        </div>

        <nav class="drawer-links" aria-label="Footer navigation">
            <a href="/play/">Play Game</a>
            <a href="/how-to-play/">How to Play</a>
            <a href="/truth-questions/">Truth Questions</a>
            <a href="/dare-ideas/">Dare Ideas</a>
            <a href="/about/">About Us</a>
            <a href="/contact/">Contact</a>
            <a href="/safety/">Safety Guide</a>
            <a href="/privacy/">Privacy Policy</a>
            <a href="/terms/">Terms of Use</a>
        </nav>

        <div class="drawer-bottom">
            <span>Play together. Make memories. Keep it fun.</span>
            <small>© {new Date().getFullYear()} TruthOrDareSpin</small>
        </div>
    </section>

    <div class="footer-toolbar">
        <div class="footer-left">
            <button
                id="footer-button"
                class="button-mini toggle-footer-menu-button"
                type="button"
                aria-expanded="false"
                aria-controls="footer-drawer"
                aria-label="Expand footer links"
            >
                <svg
                    class="footer-chevron"
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="m6 9 6 6 6-6" />
                </svg>
            </button>

            <span class="footer-label">Explore</span>
        </div>

        <nav class="footer-right" aria-label="Quick links">
            <a class="button-mini" href="/play/">Play</a>
            <a class="button-mini" href="/how-to-play/">How to Play</a>
            <a class="button-mini desktop-shortcut" href="/truth-questions/">
                Truths
            </a>
            <a class="button-mini desktop-shortcut" href="/dare-ideas/">
                Dares
            </a>
        </nav>
    </div>
</footer>

<script>

const footerButton = document.querySelector("#footer-button");
const footerDrawer = document.querySelector("#footer-drawer");
const footerToolbar = document.querySelector(".footer-toolbar");

if (footerButton && footerDrawer && footerToolbar) {
    const closeFooter = () => {
        footerButton.setAttribute("aria-expanded", "false");
        footerButton.setAttribute("aria-label", "Expand footer links");
        footerDrawer.hidden = true;
    };

    const toggleFooter = () => {
        const isExpanded =
            footerButton.getAttribute("aria-expanded") === "true";

        footerButton.setAttribute("aria-expanded", String(!isExpanded));
        footerButton.setAttribute(
            "aria-label",
            isExpanded ? "Expand footer links" : "Collapse footer links"
        );

        footerDrawer.hidden = isExpanded;
    };

    footerButton.addEventListener("click", toggleFooter);

    document.addEventListener("click", (event) => {
        if (footerButton.getAttribute("aria-expanded") !== "true") {
            return;
        }

        const target = event.target;

        if (
            target instanceof Node &&
            !footerToolbar.contains(target) &&
            !footerDrawer.contains(target)
        ) {
            closeFooter();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (
            event.key === "Escape" &&
            footerButton.getAttribute("aria-expanded") === "true"
        ) {
            closeFooter();
            footerButton.focus();
        }
    });
}
</script>

